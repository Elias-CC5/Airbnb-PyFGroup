{
  "parser": "@typescript-eslint/parser",
  "parserOptions": { "sourceType": "module" },
  "extends": ["eslint:recommended"],
  "env": { "node": true, "jest": true, "es2022": true },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off"
  }
}
