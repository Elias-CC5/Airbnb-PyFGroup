# ------------------------- APP -------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ---------------------- FRONTEND -----------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Lista separada por comas de orígenes permitidos por CORS
CORS_ORIGINS=http://localhost:3000

# ---------------------- DATABASE -----------------------
DATABASE_URL=postgresql://wasi:wasi_password@localhost:5432/wasi_peru?schema=public

# ------------------------ JWT --------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-tambien-por-otro-secreto-distinto
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# --------------------- RATE LIMIT ----------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --------------------- UPLOADS -------------------------
# local | cloudinary
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wasi-peru

# --------------------- WHATSAPP ------------------------
# Número por defecto en formato internacional sin "+" (Perú = 51)
WHATSAPP_DEFAULT_PHONE=51999888777

# ---------------------- SEED ---------------------------
# SOLO DESARROLLO — cámbialas antes de producción
SEED_ADMIN_EMAIL=admin@wasi.pe
SEED_ADMIN_PASSWORD=Admin123!
