generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS ---------------------------

enum Role {
  USER
  HOST
  ADMIN
  SUPER_ADMIN
}

enum PropertyStatus {
  DRAFT
  /// En cola de revisión del administrador antes de salir al público.
  PENDING_REVIEW
  ACTIVE
  /// El anfitrión la ocultó temporalmente; sus reservas siguen vigentes.
  PAUSED
  /// El administrador la rechazó; el anfitrión puede corregir y reenviar.
  REJECTED
  /// Retirada del catálogo, se conserva por historial.
  ARCHIVED

  /// @deprecated Usa PENDING_REVIEW. Se mantiene por las fichas ya creadas.
  PENDING
  /// @deprecated Usa PAUSED.
  INACTIVE
}

/// Política de cancelación mostrada al huésped antes de reservar.
enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

/// Tipo de cama principal del alojamiento.
enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  BUNK
  SOFA_BED
}

/// Plataforma por la que llegó el huésped. Se usa en el calendario de ocupación.
enum BookingChannel {
  DIRECT
  AIRBNB
  BOOKING
  EXPEDIA
  TIKTOK
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum Currency {
  PEN
  USD
}

// ------------------------- USERS ---------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  firstName     String    @map("first_name") @db.VarChar(80)
  lastName      String    @map("last_name") @db.VarChar(80)
  email         String    @unique @db.VarChar(160)
  phone         String?   @db.VarChar(30)
  password      String?
  googleId      String?   @unique @map("google_id")
  githubId      String?   @unique @map("github_id")
  avatarUrl     String?   @map("avatar_url")
  role          Role      @default(USER)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")

  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  properties         Property[]      @relation("PropertyOwner")
  reservations       Reservation[]
  reviews            Review[]
  favorites          Favorite[]
  contactMessages    ContactMessage[]

  hostProfile        HostProfile?
  hostApplications   HostApplication[]  @relation("HostApplicant")
  reviewedApplications HostApplication[] @relation("HostReviewer")
  documentAccesses   HostDocumentAccess[] @relation("HostDocumentViewer")
  reviewedSubscriptions HostSubscription[] @relation("SubscriptionReviewer")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Hash del refresh token (nunca se guarda el token en claro).
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ip        String?  @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ----------------------- UBICACIONES ------------------------

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(80)
  slug      String     @unique @db.VarChar(90)
  imageUrl  String?    @map("image_url")
  provinces Province[]
  locations Location[]

  @@map("departments")
}

model Province {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(80)
  slug         String     @db.VarChar(90)
  departmentId Int        @map("department_id")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  districts  District[]
  locations  Location[]

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@map("provinces")
}

model District {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(80)
  slug       String @db.VarChar(90)
  provinceId Int    @map("province_id")

  province  Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([provinceId, slug])
  @@index([provinceId])
  @@map("districts")
}

/// Dirección concreta de un alojamiento (desnormaliza dpto/prov/dist para filtros rápidos).
model Location {
  id           String  @id @default(uuid()) @db.Uuid
  address      String? @db.VarChar(200)
  reference    String? @db.VarChar(200)
  latitude     Float?
  longitude    Float?
  departmentId Int     @map("department_id")
  provinceId   Int     @map("province_id")
  districtId   Int?    @map("district_id")

  department Department @relation(fields: [departmentId], references: [id])
  province   Province   @relation(fields: [provinceId], references: [id])
  district   District?  @relation(fields: [districtId], references: [id])
  property   Property?

  @@index([departmentId, provinceId, districtId])
  @@map("locations")
}

// ------------------- CATEGORÍAS Y AMENIDADES -----------------

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(80)
  slug        String  @unique @db.VarChar(90)
  description String? @db.VarChar(255)
  icon        String? @db.VarChar(60)
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(true) @map("is_active")
  order       Int     @default(0)

  properties Property[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Amenity {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(80)
  slug     String  @unique @db.VarChar(90)
  icon     String? @db.VarChar(60)
  group    String? @db.VarChar(60)
  isActive Boolean @default(true) @map("is_active")

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id") @db.Uuid
  amenityId  Int    @map("amenity_id")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
  @@map("property_amenities")
}

// ----------------------- ALOJAMIENTOS ------------------------

model Property {
  id              String         @id @default(uuid()) @db.Uuid
  title           String         @db.VarChar(160)
  slug            String         @unique @db.VarChar(180)
  shortDescription String?       @map("short_description") @db.VarChar(255)
  description     String
  pricePerNight   Decimal        @map("price_per_night") @db.Decimal(10, 2)
  currency        Currency       @default(PEN)
  cleaningFee     Decimal        @default(0) @map("cleaning_fee") @db.Decimal(10, 2)
  maxGuests       Int            @map("max_guests")
  bedrooms        Int
  beds            Int            @default(1)
  bathrooms       Int
  minNights       Int            @default(1) @map("min_nights")
  maxNights       Int?           @map("max_nights")
  status          PropertyStatus @default(DRAFT)
  isFeatured      Boolean        @default(false) @map("is_featured")
  views           Int            @default(0)
  ratingAvg       Float          @default(0) @map("rating_avg")
  reviewsCount    Int            @default(0) @map("reviews_count")
  whatsappPhone   String?        @map("whatsapp_phone") @db.VarChar(30)
  checkInTime     String         @default("15:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime    String         @default("11:00") @map("check_out_time") @db.VarChar(5)

  // --------------------------- reglas de la casa ---------------------------
  petsAllowed         Boolean @default(false) @map("pets_allowed")
  smokingAllowed      Boolean @default(false) @map("smoking_allowed")
  partiesAllowed      Boolean @default(false) @map("parties_allowed")
  suitableForChildren Boolean @default(true) @map("suitable_for_children")
  quietHoursFrom      String? @map("quiet_hours_from") @db.VarChar(5)
  quietHoursTo        String? @map("quiet_hours_to") @db.VarChar(5)
  houseRules          String? @map("house_rules")

  // -------------------------- detalles del espacio -------------------------
  areaM2      Int?     @map("area_m2")
  floor       Int?
  hasElevator Boolean  @default(false) @map("has_elevator")
  bedType     BedType? @map("bed_type")
  viewType    String?  @map("view_type") @db.VarChar(60)

  // ---------------------------- políticas y cobros -------------------------
  cancellationPolicy CancellationPolicy @default(MODERATE) @map("cancellation_policy")
  securityDeposit    Decimal            @default(0) @map("security_deposit") @db.Decimal(10, 2)
  extraGuestFee      Decimal            @default(0) @map("extra_guest_fee") @db.Decimal(10, 2)
  weeklyDiscount     Int                @default(0) @map("weekly_discount")
  monthlyDiscount    Int                @default(0) @map("monthly_discount")

  ownerId    String @map("owner_id") @db.Uuid
  categoryId Int    @map("category_id")
  locationId String @unique @map("location_id") @db.Uuid

  owner     User     @relation("PropertyOwner", fields: [ownerId], references: [id])
  category  Category @relation(fields: [categoryId], references: [id])
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  images       PropertyImage[]
  amenities    PropertyAmenity[]
  reservations Reservation[]
  reviews      Review[]
  favorites    Favorite[]
  blocks       AvailabilityBlock[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deletedAt])
  @@index([categoryId])
  @@index([pricePerNight])
  @@index([maxGuests])
  @@index([isFeatured])
  @@map("properties")
}

model PropertyImage {
  id         String  @id @default(uuid()) @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  url        String
  publicId   String? @map("public_id")
  alt        String? @db.VarChar(160)
  order      Int     @default(0)
  isMain     Boolean @default(false) @map("is_main")
  width      Int?
  height     Int?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId, order])
  @@map("property_images")
}

// -------------------- DISPONIBILIDAD -------------------------

/// Bloqueos manuales del propietario/administrador (mantenimiento, uso propio...).
model AvailabilityBlock {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  reason     String?  @db.VarChar(160)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId, startDate, endDate])
  @@map("availability_blocks")
}

// ------------------------ RESERVAS ---------------------------

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(20)
  propertyId  String            @map("property_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  checkIn     DateTime          @map("check_in") @db.Date
  checkOut    DateTime          @map("check_out") @db.Date
  guests      Int
  nights      Int
  pricePerNight Decimal         @map("price_per_night") @db.Decimal(10, 2)
  cleaningFee Decimal           @default(0) @map("cleaning_fee") @db.Decimal(10, 2)
  totalPrice  Decimal           @map("total_price") @db.Decimal(10, 2)
  currency    Currency          @default(PEN)
  status      ReservationStatus @default(PENDING)
  channel     BookingChannel    @default(DIRECT)
  /// Nombre a mostrar en el calendario cuando la reserva viene de otra plataforma
  /// y no corresponde a un usuario registrado.
  guestName   String?           @map("guest_name") @db.VarChar(120)
  notes       String?           @db.VarChar(500)
  cancelledAt DateTime?         @map("cancelled_at")
  cancelReason String?          @map("cancel_reason") @db.VarChar(255)

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  review   Review?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([status])
  @@map("reservations")
}

// ------------------------- RESEÑAS ---------------------------

model Review {
  id            String  @id @default(uuid()) @db.Uuid
  propertyId    String  @map("property_id") @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  reservationId String? @unique @map("reservation_id") @db.Uuid
  rating        Int
  comment       String  @db.VarChar(1000)
  isVisible     Boolean @default(true) @map("is_visible")

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Una reseña por usuario y alojamiento: la reserva ya no es obligatoria,
  // así que este es el candado que evita reseñas repetidas.
  @@unique([propertyId, userId])
  @@index([propertyId])
  @@map("reviews")
}

// ------------------------ FAVORITOS --------------------------

model Favorite {
  userId     String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("favorites")
}

// --------------------- MENSAJES / CONTACTO --------------------

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(160)
  phone     String?  @db.VarChar(30)
  subject   String   @db.VarChar(160)
  message   String   @db.VarChar(2000)
  isRead    Boolean  @default(false) @map("is_read")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@map("contact_messages")
}

// -------------------- CONFIGURACIÓN ADMIN ---------------------

model Setting {
  key       String   @id @db.VarChar(80)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// -------------------- LIBRO DE RECLAMACIONES --------------------

enum ComplaintType {
  RECLAMO
  QUEJA
}

enum ComplaintStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTO
}

/// Libro de Reclamaciones Virtual (D.S. 011-2011-PCM / INDECOPI).
model ComplaintBook {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique @db.VarChar(20)
  type      ComplaintType

  // Datos del consumidor
  fullName  String          @map("full_name") @db.VarChar(160)
  docType   String          @map("doc_type") @db.VarChar(20)
  docNumber String          @map("doc_number") @db.VarChar(20)
  address   String          @db.VarChar(255)
  phone     String?         @db.VarChar(30)
  email     String          @db.VarChar(160)

  // Datos del bien contratado
  itemDescription String    @map("item_description") @db.VarChar(500)
  amount          Decimal?  @db.Decimal(10, 2)
  reservationCode String?   @map("reservation_code") @db.VarChar(20)

  // Detalle
  detail   String           @db.VarChar(2000)
  request  String           @db.VarChar(1000)

  // Gestión interna
  status       ComplaintStatus @default(PENDIENTE)
  response     String?         @db.VarChar(2000)
  respondedAt  DateTime?       @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("complaint_book")
}

// ============================================================================
//                                ANFITRIONES
// ============================================================================
//
// Un usuario normal solicita ser anfitrión, el administrador revisa su
// identidad y aprueba o rechaza. Sólo con el perfil en ACTIVE puede publicar.
//
// AVISO SOBRE DATOS PERSONALES (Ley 29733). La solicitud guarda documento de
// identidad y fotos: es dato personal y, en el caso del documento, sensible.
// Reglas que el código debe respetar y que están implementadas en el servicio:
//   · esos campos NUNCA salen en una respuesta pública ni en el perfil;
//   · sólo ADMIN y SUPER_ADMIN pueden consultarlos, y cada consulta queda
//     registrada en HostDocumentAccess;
//   · al aprobar o rechazar se borran las imágenes del documento: ya no hacen
//     falta, y guardarlas indefinidamente es un riesgo sin contrapartida.

enum HostStatus {
  /// Solicitud enviada, esperando revisión.
  PENDING
  /// Aprobado: puede publicar y administrar sus alojamientos.
  ACTIVE
  /// Suspendido por el administrador; conserva sus datos, no puede publicar.
  SUSPENDED
  /// Rechazado tras la revisión.
  REJECTED
}

enum HostApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum IdDocumentType {
  DNI
  CARNET_EXTRANJERIA
  PASAPORTE
}

/// Perfil público del anfitrión. Lo que ve un huésped en la ficha.
/// Billeteras y efectivo. No hay pasarela: todo se confirma a mano.
enum PaymentMethod {
  YAPE
  PLIN
  TRANSFER
  CASH
}

enum SubscriptionStatus {
  /// El anfitrión eligió plan y aún no reporta el pago.
  PENDING_PAYMENT
  /// Reportó el pago; falta que un administrador lo verifique.
  IN_REVIEW
  ACTIVE
  EXPIRED
  REJECTED
  CANCELLED
}

/// Plan de publicación. Editable desde el panel: los precios viven en la base,
/// no en el código.
model HostPlan {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(40)
  name   String @db.VarChar(80)
  /// Duración en días. 30, 60, 210…
  days   Int
  price  Decimal  @db.Decimal(10, 2)
  currency Currency @default(PEN)
  /// Texto suelto que se muestra bajo el nombre.
  tagline     String?  @db.VarChar(160)
  /// Viñetas de la tarjeta de precios.
  features    String[] @default([])
  isPopular   Boolean  @default(false) @map("is_popular")
  isActive    Boolean  @default(true)  @map("is_active")
  sortOrder   Int      @default(0)     @map("sort_order")

  subscriptions HostSubscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("host_plans")
}

/// Un periodo pagado. El histórico se conserva: nunca se sobrescribe una fila,
/// se crea otra.
model HostSubscription {
  id            String @id @default(uuid()) @db.Uuid
  hostProfileId String @map("host_profile_id") @db.Uuid
  planId        String @map("plan_id") @db.Uuid

  status SubscriptionStatus @default(PENDING_PAYMENT)

  /// Se rellenan al confirmar el pago, no al crear la suscripción.
  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  amount   Decimal       @db.Decimal(10, 2)
  currency Currency      @default(PEN)
  method   PaymentMethod?
  /// Número de operación de Yape/Plin o de la transferencia.
  operationNumber String? @map("operation_number") @db.VarChar(60)
  /// Captura del pago. La sube el anfitrión; el efectivo no lleva.
  proofUrl        String? @map("proof_url")
  paidAt          DateTime? @map("paid_at")

  reportedAt   DateTime? @map("reported_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  rejectionReason String? @map("rejection_reason") @db.VarChar(500)
  /// Notas internas del administrador. No las ve el anfitrión.
  adminNotes      String? @map("admin_notes") @db.VarChar(500)

  hostProfile HostProfile @relation(fields: [hostProfileId], references: [id], onDelete: Cascade)
  plan        HostPlan    @relation(fields: [planId], references: [id])
  reviewedBy  User?       @relation("SubscriptionReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hostProfileId, status])
  @@index([status, endsAt])
  @@map("host_subscriptions")
}

model HostProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  displayName String  @map("display_name") @db.VarChar(80)
  bio         String? @db.VarChar(1000)
  avatarUrl   String? @map("avatar_url")
  coverUrl    String? @map("cover_url")
  city        String? @db.VarChar(80)
  country     String  @default("Perú") @db.VarChar(60)
  /// Idiomas que habla, en códigos ISO ("es", "en", "qu").
  languages   String[] @default([])

  status    HostStatus @default(PENDING)
  hostSince DateTime?  @map("host_since")

  /// Contacto operativo. No se muestra hasta que hay una reserva.
  whatsapp     String? @db.VarChar(30)
  contactEmail String? @map("contact_email") @db.VarChar(160)

  /// Denormalizados para no recalcularlos en cada listado.
  ratingAvg       Float @default(0) @map("rating_avg")
  reviewsCount    Int   @default(0) @map("reviews_count")
  propertiesCount Int   @default(0) @map("properties_count")

  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason") @db.VarChar(500)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings      HostSettings?
  subscriptions HostSubscription[]

  /// Alojamiento que se conserva publicado cuando la suscripción vence y el
  /// anfitrión vuelve al plan gratuito. Si está vacío se usa el más antiguo.
  freeSlotPropertyId String? @unique @map("free_slot_property_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("host_profiles")
}

/// Solicitud para ser anfitrión. Contiene los datos de identidad que revisa
/// el administrador. Nunca se expone fuera del panel de administración.
model HostApplication {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  status HostApplicationStatus @default(SUBMITTED)

  // ---- datos que declara el solicitante ----
  fullName    String         @map("full_name") @db.VarChar(160)
  phone       String         @db.VarChar(30)
  occupation  String?        @db.VarChar(120)
  /// Por qué quiere ser anfitrión y qué piensa publicar.
  motivation  String         @db.VarChar(1000)
  city        String?        @db.VarChar(80)

  // ---- identidad (RESTRINGIDO) ----
  documentType   IdDocumentType @map("document_type")
  /// Sólo lo ve el administrador; se borra si la solicitud se rechaza.
  documentNumber String         @map("document_number") @db.VarChar(20)
  /// URLs privadas. Se ponen a null al resolver la solicitud.
  documentFrontUrl String? @map("document_front_url")
  documentBackUrl  String? @map("document_back_url")
  selfieUrl        String? @map("selfie_url")
  /// Marca que las imágenes ya se eliminaron tras la revisión.
  documentsPurgedAt DateTime? @map("documents_purged_at")

  // ---- revisión ----
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)

  user       User  @relation("HostApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("HostReviewer", fields: [reviewedById], references: [id])

  accesses HostDocumentAccess[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, submittedAt])
  @@index([userId])
  @@map("host_applications")
}

/// Bitácora de quién miró los documentos de una solicitud. Existe para poder
/// responder "¿quién vio mi DNI?" si el titular lo pregunta.
model HostDocumentAccess {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  viewedById    String   @map("viewed_by_id") @db.Uuid
  viewedAt      DateTime @default(now()) @map("viewed_at")
  ip            String?  @db.VarChar(45)

  application HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  viewedBy    User            @relation("HostDocumentViewer", fields: [viewedById], references: [id])

  @@index([applicationId, viewedAt])
  @@map("host_document_accesses")
}

/// Preferencias operativas del anfitrión.
model HostSettings {
  id            String @id @default(uuid()) @db.Uuid
  hostProfileId String @unique @map("host_profile_id") @db.Uuid

  notifyOnReservation Boolean @default(true) @map("notify_on_reservation")
  notifyOnCancel      Boolean @default(true) @map("notify_on_cancel")
  notifyOnReview      Boolean @default(true) @map("notify_on_review")
  notifyByEmail       Boolean @default(true) @map("notify_by_email")

  hostProfile HostProfile @relation(fields: [hostProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("host_settings")
}
