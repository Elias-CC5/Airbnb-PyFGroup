# URL interna de la API para renderizado en servidor (en Docker: http://backend:4000/api/v1)
API_INTERNAL_URL=http://localhost:4000/api/v1

# URL del sitio, para metadata / sitemap / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre público de la marca
